MONGODB_URI=mongodb://127.0.0.1:27017/splitzy
PORT=5050

# Python FastAPI analytics (settlement optimizer, budgets insights, ML categorization)
PYTHON_SERVICE_URL=http://localhost:8001
PYTHON_SERVICE_TIMEOUT_MS=8000
# Retries on 502/503/504 and timeouts (extra attempts after the first)
PYTHON_SERVICE_RETRIES=2
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated browser origins (must include your Vite dev URL)
CLIENT_ORIGIN=http://localhost:5173

# Public URL of this API (no trailing slash) — used for OAuth callback URLs
API_PUBLIC_URL=http://localhost:5050

# Express session (OAuth CSRF state). Use a long random string in production.
SESSION_SECRET=change-me-session

# Optional: persist OAuth session state in MongoDB for multi-instance deployments
# SESSION_STORE=mongo

# Production: Apple Sign-In uses cross-site POST; use SameSite=None + Secure cookies (default when NODE_ENV=production).
# Local Apple testing often requires HTTPS (e.g. tunnel) and may need:
# OAUTH_SESSION_SAMESITE=none
# COOKIE_SECURE=1

# TRUST_PROXY=1

# Google OAuth 2.0 (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback

# Sign in with Apple (Services ID, Team ID, Key ID, contents of .p8 private key)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Multiline key: use \n escapes in .env or APPLE_PRIVATE_KEY_STRING
APPLE_PRIVATE_KEY=
# APPLE_CALLBACK_URL=https://api.example.com/api/auth/apple/callback
